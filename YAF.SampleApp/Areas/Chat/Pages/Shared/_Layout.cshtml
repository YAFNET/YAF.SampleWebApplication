@using YAF.Core.Context
@using YAF.Core.Extensions
@using YAF.Web.Extensions

@* Replaces the layout of the chat page of the YAFNET.UI.Chat package *@

@inject BoardContext Current

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - YAF.SampleApp</title>
    <link rel="stylesheet" href="@Html.Raw(Current.Get<ITheme>().BuildThemePath("bootstrap-forum.min.css"))"
          type="text/css" asp-append-version="true" />
    @* the forum css has the icons (Html.Icon) *@
    <link rel="stylesheet" href="~/css/forum.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preload" href="~/webfonts/fa-solid-900.woff2" as="font" type="font/woff2" crossorigin />
    <script src="~/js/themeSelector.min.js" asp-append-version="true"></script>
</head>
<body class="site d-flex flex-column min-vh-100">
    @await Html.PartialAsync("~/Pages/Shared/_SiteHeader.cshtml")

    <main role="main" class="flex-grow-1 py-4">
        @RenderBody()
    </main>

    @await Html.PartialAsync("~/Pages/Shared/_SiteFooter.cshtml")

    <script src="~/js/forumExtensions.min.js" asp-append-version="true"></script>

    @if (!Current.IsGuest)
    {
        @await Html.PartialAsync("_LogoutConfirm")
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

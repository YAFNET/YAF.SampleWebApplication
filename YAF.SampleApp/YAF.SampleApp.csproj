<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
	  <TypeScriptJSXEmit>preserve</TypeScriptJSXEmit>
	  <CompressionEnabled>false</CompressionEnabled>
	  <Version>4.0.11</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="YAFNET.Data.SqlServer" Version="4.0.11" />
    <PackageReference Include="YAFNET.RazorPages" Version="4.0.11" />
    <PackageReference Include="SimdLinq" Version="1.3.2" />
    <PackageReference Include="YAFNET.UI.Chat" Version="4.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Pages\Shared\_Layout.cshtml">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="Pages\Counter.razor">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Update="Pages\_Imports.razor">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\uploads\" />
  </ItemGroup>

</Project>
